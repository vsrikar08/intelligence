# Run npm run setup to choose openai (cloud embeddings) or ollama (local).
MODEL_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMS=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional persistent directory; relative paths are resolved from the project root.
MEMORY_DATA_DIR=.data/mem0

# Optional answer model (npm run setup:ask). Independent of embeddings.
# Foundry: https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/
# Ollama: http://127.0.0.1:11434/v1/
ASK_BASE_URL=
ASK_MODEL=
ASK_API_KEY=
